compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  platform:
    vsphere:
      cpus: 16
      memoryMB: 32768
      osDisk:
        diskSizeGB: 120
  replicas: 2
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  platform:
    vsphere:
      cpus: 16
      memoryMB: 40960
      osDisk:
        diskSizeGB: 120
  replicas: 3
metadata:
  name: ocp-cluster-name-here
networking:
